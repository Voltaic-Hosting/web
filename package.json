{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=22.23.4",
        "pnpm": ">=12"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "format": "prettier --write \"src/**/*.{ts,astro,svelte,css}\" \"tests/**/*.ts\" \"astro.config.mjs\" \"eslint.config.js\" \"lighthouserc.cjs\"",
        "format:check": "prettier --check \"src/**/*.{ts,astro,svelte,css}\" \"tests/**/*.ts\" \"astro.config.mjs\" \"eslint.config.js\" \"lighthouserc.cjs\"",
        "typecheck": "astro check",
        "lint": "pnpm run format:check && pnpm run typecheck && eslint .",
        "test": "astro build && vitest run",
        "lighthouse:ci": "lhci autorun",
        "audit": "pnpm audit --prod"
    },
    "dependencies": {
        "@astrojs/svelte": "^9.1.0",
        "@fontsource-variable/dm-sans": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@lucide/astro": "^1.61.0",
        "@lucide/svelte": "^1.59.0",
        "astro": "^7.4.0",
        "svelte": "^5.57.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@eslint/js": "^10.0.1",
        "@lhci/cli": "^0.15.1",
        "@tailwindcss/vite": "^4.3.3",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.1",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    }
}
