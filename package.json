{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.20.0",
    "engines": {
        "node": ">=22",
        "pnpm": ">=11"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx}\" \"resources/css/**/*.css\" \"vite.config.js\" \"eslint.config.js\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx}\" \"resources/css/**/*.css\" \"vite.config.js\" \"eslint.config.js\"",
        "lint": "pnpm run format:check && pnpm run typecheck && eslint resources/js",
        "typecheck": "tsc --noEmit",
        "lighthouse:ci": "lhci autorun",
        "audit": "pnpm audit --prod"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@lhci/cli": "^0.15.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "concurrently": "^10.0.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "laravel-vite-plugin": "^3.1.3",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2"
    },
    "dependencies": {
        "@fontsource-variable/dm-sans": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@inertiajs/react": "^3.7.0",
        "lucide-react": "^1.34.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    }
}
