{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx}\" \"resources/css/**/*.css\" \"vite.config.js\" \"eslint.config.js\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx}\" \"resources/css/**/*.css\" \"vite.config.js\" \"eslint.config.js\"",
        "lint": "npm run format:check && npm run typecheck && eslint resources/js",
        "typecheck": "tsc --noEmit",
        "lighthouse:ci": "lhci autorun"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.3",
        "@lhci/cli": "^0.15.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^16.4.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.6.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.46.2",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@fontsource-variable/dm-sans": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@inertiajs/react": "^3.6.1",
        "lucide-react": "^1.28.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    }
}
