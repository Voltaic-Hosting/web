# Formbricks environment for the /contact form (self-hosted stack).
# Copy to docker/formbricks/.env and fill in real values.
# Generate secrets with: openssl rand -hex 32

# Public HTTPS URL of this Formbricks instance (required, no http://localhost in prod).
WEBAPP_URL=https://forms.voltaic.host
BETTER_AUTH_URL=https://forms.voltaic.host

POSTGRES_PASSWORD=change-me-64-hex-chars
POSTGRES_PASSWORD_URL_ENCODED=change-me-64-hex-chars

BETTER_AUTH_SECRET=change-me-64-hex-chars
ENCRYPTION_KEY=change-me-64-hex-chars
CRON_SECRET=change-me-64-hex-chars
HUB_API_KEY=change-me-64-hex-chars
CUBEJS_API_SECRET=change-me-64-hex-chars
CUBEJS_JWT_ISSUER=formbricks-web
CUBEJS_JWT_AUDIENCE=formbricks-cube

AUTHZED_TOKEN=change-me-64-hex-chars
AUTHZED_DATABASE_PASSWORD=change-me-64-hex-chars
