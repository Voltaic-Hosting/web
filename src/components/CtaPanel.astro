---
import Button from './Button.astro';
import SectionAnchor from './SectionAnchor.astro';

interface Props {
    title: string;
    body: string;
    actionHref?: string;
    actionLabel?: string;
    anchorId?: string;
}

const { title, body, actionHref = '/contact', actionLabel = 'Contact', anchorId } = Astro.props;
---

<div class="cta-panel">
    <h2 class="cta-panel__title">
        {anchorId ? (
            <span class="section__heading">
                <SectionAnchor id={anchorId} label={title} />
                {title}
            </span>
        ) : (
            title
        )}
    </h2>
    <div class="cta-panel__side">
        <p class="cta-panel__body">{body}</p>
        <div class="cta-panel__actions">
            <Button href={actionHref}>{actionLabel}</Button>
        </div>
    </div>
</div>
