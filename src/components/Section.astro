---
import SectionAnchor from './SectionAnchor.astro';

interface Props {
    id: string;
    title: string;
    lede?: string;
    gap?: 's' | 'm' | 'l';
}

const { id, title, lede, gap = 'm' } = Astro.props;
const gapClass = gap === 's' ? 'section-gap--s' : gap === 'l' ? 'section-gap--l' : 'section-gap';
---

<section class={`section ${gapClass}`} id={id}>
    <div class="container">
        <div class="section-head">
            <h2 class="section-head__title">
                <span class="section__heading">
                    <SectionAnchor id={id} label={title} />
                    {title}
                </span>
            </h2>
            {lede ? <p class="section-head__lede">{lede}</p> : null}
        </div>
        <slot />
    </div>
</section>
