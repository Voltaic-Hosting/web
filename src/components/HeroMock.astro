---
// Real screenshot of the Voltaic Panel demo for the home hero.
---

<div class="mock" role="img" aria-label="Preview of the Voltaic Panel dashboard">
    <div class="mock__bar">
        <div class="mock__dots" aria-hidden="true">
            <span class="mock__dot"></span>
            <span class="mock__dot"></span>
            <span class="mock__dot"></span>
        </div>
        <span class="mock__url">panel.voltaic.host</span>
    </div>
    <img
        class="mock__shot"
        src="/images/panel-overview.png"
        alt="Voltaic Panel dashboard with a Minecraft server, Valheim server, personal website, and Discord bot"
        width="1217"
        height="729"
    />
</div>
