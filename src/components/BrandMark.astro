---
import { site } from '@/data/site';

interface Props {
    href?: string;
    class?: string;
}

const { href = '/', class: className = '' } = Astro.props;
const classes = ['brand-mark', className].filter(Boolean).join(' ');
---

<a href={href} class={classes}>
    <img
        class="brand-mark__img brand-mark__img--light"
        src="/brand/logo-on-light.png"
        alt=""
        width={40}
        height={43}
        decoding="async"
    />
    <img
        class="brand-mark__img brand-mark__img--dark"
        src="/brand/logo-on-dark.png"
        alt=""
        width={40}
        height={43}
        decoding="async"
    />
    <span class="brand-mark__text">{site.name}</span>
</a>

<style>
    .brand-mark__img--dark {
        display: none;
    }

    :global([data-theme='dark']) .brand-mark__img--light {
        display: none;
    }

    :global([data-theme='dark']) .brand-mark__img--dark {
        display: block;
    }
</style>
