---
import type { BrandingAsset, BrandingFormat } from '@/data/types';

const formatLabels: Record<BrandingFormat, string> = {
    png: 'PNG',
    jpg: 'JPG',
    webp: 'WEBP',
};

const formats: BrandingFormat[] = ['png', 'jpg', 'webp'];

interface Props {
    asset: BrandingAsset;
}

const { asset } = Astro.props;
---

<article class="brand-card">
    <div class={`brand-card__preview brand-card__preview--${asset.preview}`}>
        <img src={asset.formats.png} alt="" loading="lazy" decoding="async" />
    </div>
    <div class="brand-card__body">
        <h2 class="brand-card__title">{asset.label}</h2>
        <p class="brand-card__desc">{asset.description}</p>
        <div class="brand-card__formats">
            {formats.map((option) => (
                <a
                    href={asset.formats[option]}
                    class="brand-card__format-btn"
                    download
                    aria-label={`Download ${asset.label} as ${formatLabels[option]}`}
                >
                    {formatLabels[option]}
                </a>
            ))}
        </div>
    </div>
</article>
