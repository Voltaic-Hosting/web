---
import { site } from '@/data/site';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { statusIcons } from '@/data/icons';

interface Props {
    status: number;
    title: string;
    description: string;
}

const { status, title, description } = Astro.props;

const helpfulLinks = [
    { href: '/', label: 'Home' },
    { href: '/faq', label: 'FAQ' },
    { href: '/about', label: 'About' },
    { href: '/contact', label: 'Contact' },
] as const;
---

<section class="error-page" aria-labelledby="error-title">
    <div class="container">
        <p class="error-page__code" aria-hidden="true">
            <Icon name={statusIcons[status] ?? 'triangle-alert'} size={40} />
            {status}
        </p>
        <h1 class="error-page__title" id="error-title">
            <span class="visually-hidden">Error {status}: </span>
            {title}
        </h1>
        <p class="error-page__desc">{description}</p>

        <div class="error-page__actions">
            <Button href="/">Back to home</Button>
            {status === 419 ? (
                <a href={Astro.url.pathname} class="btn btn--secondary">
                    Refresh page
                </a>
            ) : (
                <Button href="/contact" variant="secondary">
                    Contact {site.name}
                </Button>
            )}
        </div>

        <nav class="error-page__nav" aria-label="Helpful links">
            {helpfulLinks.map((link) => (
                <a href={link.href} class="site-footer__link">
                    {link.label}
                </a>
            ))}
        </nav>
    </div>
</section>
