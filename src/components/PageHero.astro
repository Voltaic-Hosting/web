---
import SectionAnchor from './SectionAnchor.astro';

interface Props {
    id?: string;
    eyebrow?: string;
    title: string;
    lede?: string;
    align?: 'start' | 'center';
    compact?: boolean;
}

const { id, eyebrow, title, lede, align = 'start', compact = false } = Astro.props;

const className = [
    'page-hero',
    align === 'center' ? 'page-hero--center' : '',
    compact ? 'page-hero--compact' : '',
]
    .filter(Boolean)
    .join(' ');
const anchorId = id ?? undefined;
---

<section class={className} id={anchorId}>
    <div class="site-container">
        {eyebrow ? <p class="page-hero__eyebrow">{eyebrow}</p> : null}
        <h1 class="page-hero__title">
            {anchorId ? (
                <span class="section__heading">
                    <SectionAnchor id={anchorId} label={title} />
                    {title}
                </span>
            ) : (
                title
            )}
        </h1>
        {lede ? <p class="page-hero__lede">{lede}</p> : null}
        {Astro.slots.has('default') ? (
            <div class="page-hero__actions">
                <slot />
            </div>
        ) : null}
    </div>
</section>
