---
import { sectionId } from '@/lib/sectionId';
import type { LegalSection } from '@/data/types';

interface Props {
    intro: string;
    sections: LegalSection[];
}

const { intro, sections } = Astro.props;
---

<div class="prose">
    <p class="prose__intro">{intro}</p>

    {sections.map((section) => {
        const id = sectionId(section.title);

        return (
            <section class="prose__section" id={id}>
                <h2 class="prose__title">{section.title}</h2>
                <div class="prose__body">
                    {section.paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                    ))}
                    {section.list.length > 0 ? (
                        <ul class="prose__list">
                            {section.list.map((item) => (
                                <li>{item}</li>
                            ))}
                        </ul>
                    ) : null}
                </div>
            </section>
        );
    })}
</div>
