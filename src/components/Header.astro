---
import { Menu, X } from '@lucide/astro';
import { products } from '@/data/products';
import { isActiveRoute } from '@/lib/url';
import { productIcons } from '@/data/icons';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { IconName } from '@/data/icons';

const url = Astro.url.pathname;
const isContact = isActiveRoute(url, '/contact');
const companyLinks = [
    { label: 'Business', href: '/business' },
    { label: 'About', href: '/about' },
    { label: 'FAQ', href: '/faq' },
];
---

<header class="site-header">
    <div class="container site-header__inner">
        <BrandMark />

        <nav class="site-nav" aria-label="Primary">
            <details class="nav-dropdown">
                <summary class="nav-link nav-dropdown__summary">
                    Products
                    <Icon name="chevron-down" size={16} class="nav-dropdown__chevron" />
                </summary>
                <div class="nav-dropdown__menu">
                    {products.map((product) => (
                        <a href={product.href} class="nav-dropdown__link">
                            <Icon
                                name={productIcons[product.slug] as IconName}
                                size={18}
                                class="nav-dropdown__icon"
                            />
                            <span>
                                <span class="nav-dropdown__label">{product.navLabel}</span>
                                <span class="nav-dropdown__desc">{product.cardSummary}</span>
                            </span>
                        </a>
                    ))}
                </div>
            </details>
            {companyLinks.map((item) => (
                <a
                    href={item.href}
                    class={`nav-link${isActiveRoute(url, item.href) ? ' is-active' : ''}`}
                    aria-current={isActiveRoute(url, item.href) ? 'page' : undefined}
                >
                    {item.label}
                </a>
            ))}
        </nav>

        <div class="site-header__actions">
            <a
                href="/contact"
                class="btn btn--primary btn--sm site-header__contact"
                aria-current={isContact ? 'page' : undefined}
            >
                <Icon name="mail" size={16} />
                Contact
            </a>
            <ThemeToggle class="site-header__toggle" />
            <details class="mobile-menu">
                <summary class="icon-btn menu-toggle" aria-label="Menu">
                    <Menu size={22} aria-hidden="true" class="menu-icon menu-icon--open" />
                    <X size={22} aria-hidden="true" class="menu-icon menu-icon--close" />
                </summary>
                <nav class="mobile-nav" aria-label="Mobile">
                    <div class="mobile-nav__inner">
                        <p class="mobile-nav__label">Products</p>
                        {products.map((product) => (
                            <a
                                href={product.href}
                                class={`mobile-nav__link${isActiveRoute(url, product.href) ? ' is-active' : ''}`}
                                aria-current={isActiveRoute(url, product.href) ? 'page' : undefined}
                            >
                                <Icon
                                    name={productIcons[product.slug] as IconName}
                                    size={20}
                                    class="mobile-nav__icon"
                                />
                                {product.navLabel}
                            </a>
                        ))}
                        <p class="mobile-nav__label">Company</p>
                        {companyLinks.map((item) => (
                            <a
                                href={item.href}
                                class={`mobile-nav__link${isActiveRoute(url, item.href) ? ' is-active' : ''}`}
                                aria-current={isActiveRoute(url, item.href) ? 'page' : undefined}
                            >
                                {item.label}
                            </a>
                        ))}
                        <a
                            href="/contact"
                            class="btn btn--primary mobile-nav__cta"
                            aria-current={isContact ? 'page' : undefined}
                        >
                            <Icon name="mail" size={18} />
                            Contact us
                        </a>
                        <div class="mobile-nav__theme">
                            <span>Theme</span>
                            <ThemeToggle />
                        </div>
                    </div>
                </nav>
            </details>
        </div>
    </div>
</header>

<script>
    // Progressive enhancement only. The details/summary menus work without JS.
    const header = document.querySelector<HTMLElement>('.site-header');
    if (header) {
        const details = header.querySelectorAll<HTMLDetailsElement>('details');

        const closeAll = (except?: HTMLDetailsElement) => {
            details.forEach((d) => {
                if (d !== except) d.open = false;
            });
        };

        details.forEach((d) => {
            d.addEventListener('toggle', () => {
                if (d.open) closeAll(d);
            });
        });

        document.addEventListener('pointerdown', (event) => {
            if (!(event.target instanceof Element) || !header.contains(event.target)) {
                closeAll();
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeAll();
        });

        const mq = window.matchMedia('(min-width: 60rem)');
        mq.addEventListener('change', (event) => {
            if (event.matches) closeAll();
        });
    }
</script>
