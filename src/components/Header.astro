---
import { Menu, X } from '@lucide/astro';
import { site } from '@/data/site';
import { isActiveRoute } from '@/lib/url';
import BrandMark from './BrandMark.astro';
import ThemeToggle from './ThemeToggle.astro';

const url = Astro.url.pathname;
const isContact = isActiveRoute(url, '/contact');
---

<header class="site-header field">
    <div class="container site-header__inner">
        <BrandMark />

        <nav class="site-nav" aria-label="Primary">
            {site.nav.map((item) => (
                <a
                    href={item.href}
                    class={`nav-link${isActiveRoute(url, item.href) ? ' is-active' : ''}`}
                    aria-current={isActiveRoute(url, item.href) ? 'page' : undefined}
                >
                    {item.label}
                </a>
            ))}
        </nav>

        <div class="site-header__actions">
            <a
                href="/contact"
                class="btn btn--ghost site-header__contact"
                aria-current={isContact ? 'page' : undefined}
            >
                Contact
            </a>
            <ThemeToggle class="site-header__toggle" />
            <button
                type="button"
                class="menu-toggle"
                aria-expanded="false"
                aria-controls="mobile-nav"
                aria-label="Open menu"
            >
                <Menu
                    size={22}
                    aria-hidden="true"
                    class="menu-toggle__icon menu-toggle__icon--open"
                />
                <X
                    size={22}
                    aria-hidden="true"
                    class="menu-toggle__icon menu-toggle__icon--close"
                />
            </button>
        </div>
    </div>

    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
        <div class="mobile-nav__inner">
            {site.nav.map((item) => (
                <a
                    href={item.href}
                    class={`mobile-nav__link${isActiveRoute(url, item.href) ? ' is-active' : ''}`}
                    aria-current={isActiveRoute(url, item.href) ? 'page' : undefined}
                >
                    {item.label}
                </a>
            ))}
            <a
                href="/contact"
                class="btn btn--seal mobile-nav__contact"
                aria-current={isContact ? 'page' : undefined}
            >
                Contact
            </a>
            <div class="mobile-nav__theme">
                <span class="mobile-nav__theme-label">Theme</span>
                <ThemeToggle />
            </div>
        </div>
    </nav>
</header>

<style>
    .menu-toggle__icon--close {
        display: none;
    }

    .site-header[data-menu-open] .menu-toggle__icon--open {
        display: none;
    }

    .site-header[data-menu-open] .menu-toggle__icon--close {
        display: block;
    }
</style>

<script>
    const header = document.querySelector<HTMLElement>('.site-header');
    const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    const main = document.querySelector('main');
    const footer = document.querySelector('footer');

    function setOpen(open: boolean): void {
        if (!mobileNav || !menuToggle || !header) return;

        mobileNav.classList.toggle('is-open', open);
        mobileNav.hidden = !open;
        header.toggleAttribute('data-menu-open', open);
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        document.documentElement.classList.toggle('menu-open', open);
        document.body.style.overflow = open ? 'hidden' : '';
        main?.toggleAttribute('inert', open);
        footer?.toggleAttribute('inert', open);

        if (open) {
            mobileNav.querySelector<HTMLElement>('a, button')?.focus();
        } else {
            menuToggle.focus();
        }
    }

    menuToggle?.addEventListener('click', () => {
        setOpen(mobileNav?.hidden !== false);
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileNav?.classList.contains('is-open')) {
            setOpen(false);
            return;
        }

        if (event.key === 'Tab' && mobileNav?.classList.contains('is-open')) {
            const focusable = mobileNav.querySelectorAll<HTMLElement>(
                'a[href], button:not([disabled])',
            );
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (!first || !last) return;
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        }
    });

    mobileNav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
    });

    const mq = window.matchMedia('(min-width: 60rem)');
    mq.addEventListener('change', (event) => {
        if (event.matches && mobileNav?.classList.contains('is-open')) {
            setOpen(false);
        }
    });
</script>
