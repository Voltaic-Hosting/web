---
import type { Value } from '@/data/types';

import type { IconName } from '@/data/icons';
import Icon from './Icon.astro';

interface Props {
    value: Value;
    icon?: IconName;
}

const { value, icon } = Astro.props;
---

<div class="value-card">
    <h3 class="value-card__title">
        {icon ? <Icon name={icon} size={24} class="value-card__icon" /> : null}
        {value.title}
    </h3>
    <p class="value-card__body">{value.body}</p>
</div>
