---
import PageHero from '@/components/PageHero.astro';
import BrandingAssetCard from '@/components/BrandingAssetCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { branding } from '@/data/branding';
import { site } from '@/data/site';
---

<BaseLayout
    title="Branding"
    description={`${site.name} logo files for press, partners, and documentation.`}
    path="/branding"
    jsonLd={{
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: `${site.name} branding`,
        url: `${site.domain}/branding`,
        description: branding.intro,
        isPartOf: {
            '@type': 'WebSite',
            name: site.name,
            url: site.domain,
        },
    }}
>
    <PageHero title="Logo files" lede={branding.intro} />

    <section class="section section--s" id="assets">
        <div class="container">
            <div class="branding-grid">
                {branding.assets.map((asset) => (
                    <BrandingAssetCard asset={asset} />
                ))}
            </div>
        </div>
    </section>
</BaseLayout>
