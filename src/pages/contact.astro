---
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { products } from '@/data/products';
import { site } from '@/data/site';
import { productIcons } from '@/data/icons';
import type { IconName } from '@/data/icons';

const includeItems: [IconName, string][] = [
    ['gamepad-2', 'The game or site you want'],
    ['users', 'How many players or visitors'],
    ['hard-drive', 'Any mods, plugins, or requirements'],
    ['calendar', 'Your timeline'],
];

const surveyUrl = site.contact.formSurveyUrl;
const embedSrc = surveyUrl ? `${surveyUrl}${surveyUrl.includes('?') ? '&' : '?'}embed=true` : '';
---

<BaseLayout
    title="Contact"
    description={`Contact ${site.name} at ${site.contact.email}.`}
    path="/contact"
    jsonLd={{
        '@context': 'https://schema.org',
        '@type': 'ContactPage',
        name: `Contact ${site.name}`,
        url: `${site.domain}/contact`,
        mainEntity: {
            '@type': 'Organization',
            name: site.name,
            email: site.contact.email,
            url: site.domain,
        },
    }}
>
    <PageHero
        title="Tell us what you want online"
        lede="Send email or use the form. Plain language is fine, a human reads everything."
    />

    {surveyUrl ? (
        <section class="section section--s" id="email">
            <div class="container contact-grid">
                <div class="contact-info">
                    <a href={`mailto:${site.contact.email}`} class="contact-email">
                        <Icon name="mail" size={22} />
                        {site.contact.email}
                    </a>
                    <p class="contact-meta">{site.contact.responseTime}</p>
                    <p class="contact-info__note">
                        Prefer email? Send the details and a human will reply. The form goes to the
                        same inbox.
                    </p>
                </div>
                <div class="contact-form">
                    <iframe
                        class="contact-form__frame"
                        src={embedSrc}
                        title="Contact form"
                        loading="lazy"
                    ></iframe>
                </div>
            </div>
        </section>
    ) : (
        <section class="section section--s" id="email">
            <div class="container contact-hero">
                <p>
                    <a href={`mailto:${site.contact.email}`} class="contact-email">
                        <Icon name="mail" size={22} />
                        {site.contact.email}
                    </a>
                </p>
                <p class="contact-meta">{site.contact.responseTime}</p>
            </div>
        </section>
    )}

    <section class="section section--s section--surface" id="include">
        <div class="container">
            <div class="section-head">
                <div class="section-head__title">
                    <h2 class="section-title">What to include</h2>
                </div>
            </div>
            <div class="include-grid">
                {includeItems.map(([icon, label]) => (
                    <div class="include-item">
                        <Icon name={icon} size={20} />
                        {label}
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="section section--s" id="products">
        <div class="container">
            <div class="section-head">
                <div class="section-head__title">
                    <h2 class="section-title">What you can ask for</h2>
                </div>
                <p class="section-head__lede">
                    Not sure which fits? Describe the project and we will point you at the right
                    one. For infrastructure work, see{' '}
                    <a href="/business" class="link-arrow">
                        business services
                    </a>
                    .
                </p>
            </div>
            <div class="card-grid">
                {products.map((product) => (
                    <a href={product.href} class="card card--link">
                        <span class="card__icon">
                            <Icon name={productIcons[product.slug] as IconName} size={24} />
                        </span>
                        <h3 class="card__title">{product.title}</h3>
                        <p class="card__body">{product.cardSummary}</p>
                        <span class="card__link">
                            Learn more
                            <Icon name="arrow-right" size={16} />
                        </span>
                    </a>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>
