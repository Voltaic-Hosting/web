---
import Button from '@/components/Button.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sectionId } from '@/lib/sectionId';
import { faqPageJsonLd } from '@/lib/seo';
import { faq } from '@/data/faq';
import { faqGroupIcons } from '@/data/icons';
import { site } from '@/data/site';
import type { IconName } from '@/data/icons';

const items = faq.groups.flatMap((group) => group.items);
---

<BaseLayout
    title="FAQ"
    description={faq.intro}
    path="/faq"
    jsonLd={faqPageJsonLd(site, {
        name: `FAQ · ${site.name}`,
        path: '/faq',
        description: faq.intro,
        items,
    })}
>
    <PageHero title="FAQ" lede={faq.intro}>
        <Button href="/contact">
            <Icon name="mail" size={18} />
            Contact
        </Button>
        <Button href="/about" variant="secondary">
            About
        </Button>
    </PageHero>

    <section class="section section--s" aria-label="FAQ topics">
        <div class="container">
            <div class="game-strip game-strip--start">
                {faq.groups.map((group) => {
                    const id = sectionId(group.title);
                    const groupIcon = faqGroupIcons[group.title] as IconName | undefined;
                    return (
                        <a href={`#${id}`} class="game-chip">
                            {groupIcon ? <Icon name={groupIcon} size={18} /> : null}
                            {group.title}
                        </a>
                    );
                })}
            </div>
        </div>
    </section>

    <section class="section section--s" aria-label="FAQ topics">
        <div class="container container--narrow">
            {faq.groups.map((group) => {
                const id = sectionId(group.title);
                const groupIcon = faqGroupIcons[group.title] as IconName | undefined;
                return (
                    <div class="faq-group" id={id}>
                        <h2 class="faq-group__title">
                            {groupIcon ? <Icon name={groupIcon} size={20} /> : null}
                            {group.title}
                        </h2>
                        <div class="faq">
                            {group.items.map((item) => (
                                <details class="faq__item">
                                    <summary class="faq__question">{item.question}</summary>
                                    <div class="faq__answer">
                                        {item.answer.map((paragraph) => (
                                            <p>{paragraph}</p>
                                        ))}
                                    </div>
                                </details>
                            ))}
                        </div>
                    </div>
                );
            })}
        </div>
    </section>

    <CtaBand
        title="Still need help?"
        body="Send the details that matter and we will reply within two business days, Monday through Friday."
        actionLabel="Contact us"
    />
</BaseLayout>
