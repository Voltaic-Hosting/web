---
import Button from '@/components/Button.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Section from '@/components/Section.astro';
import SectionAnchor from '@/components/SectionAnchor.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sectionId } from '@/lib/sectionId';
import { webPageJsonLd } from '@/lib/seo';
import { about } from '@/data/about';
import { site } from '@/data/site';
import { values } from '@/data/values';
import ValueCard from '@/components/ValueCard.astro';
import { valueIcons } from '@/data/icons';
---

<BaseLayout
    title="About"
    description={about.intro}
    path="/about"
    jsonLd={webPageJsonLd(site, {
        name: `About ${site.name}`,
        path: '/about',
        description: about.intro,
        type: 'AboutPage',
    })}
>
    <PageHero id="about" title="About" lede={about.intro}>
        <Button href="/contact">Contact</Button>
    </PageHero>

    <section class="section paper section-gap--hero" aria-label="Data centre">
        <div class="container">
            <figure class="mono-photo mono-photo--wide">
                <img
                    src="/images/photos/noirlab-hq-server-racks-6v6a0395-cc-1920.jpg"
                    alt="Server racks with rows of blue and green status lights"
                    width={1920}
                    height={1280}
                    loading="lazy"
                    decoding="async"
                />
            </figure>
        </div>
    </section>

    <section class="section paper section-gap--s" id="company">
        <div class="container">
            {about.sections.map((section) => {
                const id = sectionId(section.title);

                return (
                    <div class="about-row" id={id}>
                        <h2 class="about-row__title">
                            <span class="section__heading">
                                <SectionAnchor id={id} label={section.title} />
                                {section.title}
                            </span>
                        </h2>
                        <div class="about-row__body">
                            {section.paragraphs.map((paragraph) => (
                                <p>{paragraph}</p>
                            ))}
                        </div>
                    </div>
                );
            })}
        </div>
    </section>

    <Section
        id="values"
        title="Billing, privacy, and exit"
        lede="Cancel when you want. Pay what was quoted. Keep your data off the sales floor."
    >
        <ul class="value-grid">
            {values.map((value, index) => (
                <li>
                    <ValueCard value={value} icon={valueIcons[index]} />
                </li>
            ))}
        </ul>
    </Section>

    <section class="section paper section-gap--s" id="details">
        <div class="container">
            <div class="section-head">
                <h2 class="section-head__title">
                    <span class="section__heading">
                        <SectionAnchor id="details" label="Details" />
                        Details
                    </span>
                </h2>
            </div>
            <div class="col-group col-group--four">
                <div class="col-group__col">
                    <p class="info-label">
                        <Icon name="user-round" size={16} class="info-label__icon" />
                        Founder
                    </p>
                    <p class="info-value">Ivan (Sudo-Ivan)</p>
                </div>

                <div class="col-group__col">
                    <p class="info-label">
                        <Icon name="building" size={16} class="info-label__icon" />
                        Company
                    </p>
                    <p class="info-value">{site.name}</p>
                    <p class="info-meta">United States</p>
                    <p class="info-meta">Solo</p>
                </div>

                <div class="col-group__col">
                    <p class="info-label">
                        <Icon name="credit-card" size={16} class="info-label__icon" />
                        Payments
                    </p>
                    <p class="info-value">USD, EUR, Monero</p>
                    <p class="info-meta">Fiat via Stripe</p>
                    <p class="info-meta">30-day refund window</p>
                </div>

                <div class="col-group__col">
                    <p class="info-label">
                        <Icon name="mail" size={16} class="info-label__icon" />
                        Contact
                    </p>
                    <p class="info-value">
                        <a href={`mailto:${site.contact.email}`} class="info-link">
                            {site.contact.email}
                        </a>
                    </p>
                    <p class="info-meta">{site.contact.responseTime}</p>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
