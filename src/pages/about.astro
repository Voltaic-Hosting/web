---
import Button from '@/components/Button.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sectionId } from '@/lib/sectionId';
import { webPageJsonLd } from '@/lib/seo';
import { about } from '@/data/about';
import { site } from '@/data/site';
import { values } from '@/data/values';
import { valueIcons, detailIcons } from '@/data/icons';
---

<BaseLayout
    title="About"
    description="Voltaic Hosting builds game server, website, and private server software. Founded by Ivan (Sudo-Ivan), based in the United States."
    path="/about"
    jsonLd={webPageJsonLd(site, {
        name: `About ${site.name}`,
        path: '/about',
        description: about.intro,
        type: 'AboutPage',
    })}
>
    <PageHero title="Built by people who run servers for a living" lede={about.intro}>
        <Button href="/contact">
            <Icon name="mail" size={18} />
            Contact
        </Button>
    </PageHero>

    <section class="section section--s" aria-label="Company story">
        <div class="container container--narrow">
            {about.sections.map((section) => {
                const id = sectionId(section.title);
                return (
                    <div class="prose__section" id={id}>
                        <h2 class="prose__title">{section.title}</h2>
                        <div class="prose__body">
                            {section.paragraphs.map((paragraph) => (
                                <p>{paragraph}</p>
                            ))}
                        </div>
                    </div>
                );
            })}
        </div>
    </section>

    <section class="section section--s section--surface" id="values" aria-label="Values">
        <div class="container">
            <div class="section-head">
                <div class="section-head__title">
                    <h2 class="section-title">Billing, privacy, and exit</h2>
                </div>
                <p class="section-head__lede">
                    Cancel when you want. Pay what was quoted. Keep your data off the sales floor.
                </p>
            </div>
            <div class="item-grid">
                {values.map((value, index) => (
                    <div class="item-cell">
                        <span class="item-cell__icon">
                            <Icon name={valueIcons[index]} size={22} />
                        </span>
                        <h3 class="item-cell__title">{value.title}</h3>
                        <p class="item-cell__body">{value.body}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="section section--s" id="details" aria-label="Details">
        <div class="container">
            <div class="card-grid card-grid--4">
                <div class="card">
                    <span class="card__icon">
                        <Icon name={detailIcons['Founder']} size={24} />
                    </span>
                    <h3 class="card__title card__title--sm">Founder</h3>
                    <p class="card__body">Ivan (Sudo-Ivan)</p>
                </div>
                <div class="card">
                    <span class="card__icon">
                        <Icon name={detailIcons['Company']} size={24} />
                    </span>
                    <h3 class="card__title card__title--sm">Company</h3>
                    <p class="card__body">{site.name}</p>
                    <p class="card__body card__body--sm">United States</p>
                </div>
                <div class="card">
                    <span class="card__icon">
                        <Icon name={detailIcons['Payments']} size={24} />
                    </span>
                    <h3 class="card__title card__title--sm">Payments</h3>
                    <p class="card__body">USD, EUR, Monero</p>
                    <p class="card__body card__body--sm">Fiat via Stripe · 30-day refund window</p>
                </div>
                <div class="card">
                    <span class="card__icon">
                        <Icon name={detailIcons['Contact']} size={24} />
                    </span>
                    <h3 class="card__title card__title--sm">Contact</h3>
                    <p class="card__body">
                        <a href={`mailto:${site.contact.email}`} class="link-arrow">
                            {site.contact.email}
                        </a>
                    </p>
                    <p class="card__body card__body--sm">{site.contact.responseTime}</p>
                </div>
            </div>
        </div>
    </section>

    <CtaBand
        title="Talk to the people who build it."
        body="Email us with questions about hosting, the panel, or a project you have in mind."
        actionLabel="Contact us"
        secondaryHref="/faq"
        secondaryLabel="Read the FAQ"
    />
</BaseLayout>
